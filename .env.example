# ──────────────────────────────────────────────────────────────
# Puppy Yoga Retreat — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://pyr:pyr_dev_password@localhost:5432/pyr
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-character-string-at-least-32-chars
API_KEY=change-me-to-a-random-api-key

# ── Email (GMX) ─────────────────────────────────────────────
IMAP_HOST=imap.gmx.net
IMAP_PORT=993
SMTP_HOST=mail.gmx.net
SMTP_PORT=587
EMAIL_USER=puppyyogaretreat@gmx.de
EMAIL_PASS=
EMAIL_POLL_MIN_DATE=today

# ── AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# ── Apple Calendar (CalDAV) ──────────────────────────────────
CALDAV_URL=
CALDAV_USER=
CALDAV_PASS=

# ── Telegram (AI Assistant) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# ── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── PayPal (Phase 2) ────────────────────────────────────────
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
