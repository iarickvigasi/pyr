# ──────────────────────────────────────────────────────────────
# Puppy Yoga Retreat — Production Environment Variables
# Copy this file to .env on the production server and fill in the values.
# This file is for the Docker Compose application stack.
# OpenClaw host-level secrets live separately; see:
# - docs/deployment/OPENCLAW_SETUP.md
# - docs/deployment/examples/openclaw.env.example
# ──────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=https://app.puppyyogaretreat.com
LOG_LEVEL=info

# ── Database / Redis ─────────────────────────────────────────
# Use Docker service names in production.
DATABASE_URL=postgresql://pyr:CHANGE_ME_DB_PASSWORD@postgres:5432/pyr
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHAR_SECRET
API_KEY=CHANGE_ME_TO_A_RANDOM_API_KEY

# ── Email (optional bootstrap; can later be moved to Settings UI) ──────────
IMAP_HOST=imap.gmx.net
IMAP_PORT=993
SMTP_HOST=mail.gmx.net
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_POLL_MIN_DATE=today

# ── AI / Assistant ───────────────────────────────────────────
# Backend does not call model providers directly. OpenClaw uses the provider
# keys on the host daemon side. Keep these blank unless you intentionally want
# them mirrored into the backend environment as well.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Backend container reaches the host-level OpenClaw gateway through the Docker
# host gateway alias configured in docker-compose.prod.yml.
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
OPENCLAW_GATEWAY_WS_URL=ws://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_OPENCLAW_GATEWAY_TOKEN
OPENCLAW_HOOK_TOKEN=CHANGE_ME_OPENCLAW_HOOK_TOKEN

# ── Apple Calendar (optional; can also be configured in Settings UI) ───────
CALDAV_URL=https://caldav.icloud.com
CALDAV_USER=
CALDAV_PASS=

# ── Telegram notifications (backend-side routing config only) ──────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
NOTIFY_TELEGRAM_ENABLED=true
NOTIFY_TELEGRAM_OWNER_USER_ID=
NOTIFY_INBOX_SCOPE=conversation,ota

# ── MotoPress (optional) ─────────────────────────────────────
MOTOPRESS_ENABLED=false
MOTOPRESS_BASE_URL=
MOTOPRESS_CONSUMER_KEY=
MOTOPRESS_CONSUMER_SECRET=
MOTOPRESS_TIMEOUT_MS=15000
MOTOPRESS_SYNC_INTERVAL_MINUTES=5

# ── Frontend build/runtime ───────────────────────────────────
# This value is inlined into the Next.js client bundle at build time.
NEXT_PUBLIC_API_URL=https://api.puppyyogaretreat.com
