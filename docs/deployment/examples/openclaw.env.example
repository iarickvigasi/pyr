# Host-level environment file for the OpenClaw gateway service.
# This file does NOT belong in the Docker Compose stack.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_OPENCLAW_GATEWAY_TOKEN
OPENCLAW_HOOK_TOKEN=CHANGE_ME_OPENCLAW_HOOK_TOKEN

PYR_API_URL=http://127.0.0.1:3001
PYR_API_KEY=CHANGE_ME_PYR_API_KEY

PYR_OPENCLAW_PLUGIN_PATH=/opt/pyr/packages/assistant/openclaw-plugin
PYR_OPENCLAW_WORKSPACE=/opt/pyr/openclaw/workspace
