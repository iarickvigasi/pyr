{
  "env": {
    "vars": {
      "PYR_API_URL": "http://localhost:3001",
      "PYR_API_KEY": "${API_KEY}"
    }
  },
  "logging": {
    "level": "debug"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-5-20250929",
        "fallbacks": [
          "openai/gpt-4o"
        ]
      },
      "contextTokens": 200000,
      "timeoutSeconds": 120
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${OPENCLAW_HOOK_TOKEN}",
    "defaultSessionKey": "hook:pyr",
    "allowedAgentIds": [
      "hooks",
      "main"
    ],
    "maxBodyBytes": 262144,
    "mappings": [
      {
        "match": {
          "path": "draft"
        },
        "action": "agent",
        "agentId": "main",
        "sessionKey": "hook:draft:{{message}}",
        "deliver": false
      },
      {
        "match": {
          "path": "briefing"
        },
        "action": "agent",
        "agentId": "main",
        "sessionKey": "hook:briefing",
        "deliver": true
      },
      {
        "match": {
          "path": "alert"
        },
        "action": "agent",
        "agentId": "main",
        "sessionKey": "hook:alert",
        "deliver": true
      }
    ]
  },
  "channels": {
    "whatsapp": {
      "sendReadReceipts": true,
      "dmPolicy": "allowlist",
      "allowFrom": [
        "INES_PHONE_NUMBER_PLACEHOLDER"
      ],
      "groupPolicy": "allowlist",
      "textChunkLimit": 4000,
      "chunkMode": "newline",
      "debounceMs": 0,
      "mediaMaxMb": 10
    }
  },
  "gateway": {
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": []
    },
    "entries": {}
  },
  "plugins": {
    "load": {
      "paths": [
        "/Users/iavi/Projects/PYR/packages/assistant/openclaw-plugin"
      ]
    },
    "entries": {
      "pyr-assistant": {
        "config": {
          "apiUrl": "http://localhost:3001",
          "apiKey": "${API_KEY}"
        }
      },
      "whatsapp": {
        "enabled": true
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.2.17",
    "lastTouchedAt": "2026-02-22T14:04:34.374Z"
  }
}
