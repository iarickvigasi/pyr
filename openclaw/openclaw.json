{
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-5-20250929",
        "fallbacks": ["openai/gpt-4o"]
      },
      "contextTokens": 200000,
      "timeoutSeconds": 120
    }
  },
  "plugins": {
    "load": {
      "paths": ["/home/node/.openclaw/plugins/pyr-assistant"]
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": ["INES_PHONE_NUMBER_PLACEHOLDER"],
      "sendReadReceipts": true,
      "textChunkLimit": 4000,
      "chunkMode": "newline",
      "mediaMaxMb": 10
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOK_TOKEN}",
    "path": "/hooks",
    "defaultSessionKey": "hook:pyr",
    "allowedAgentIds": ["hooks", "main"],
    "maxBodyBytes": 262144,
    "mappings": [
      {
        "match": { "path": "draft" },
        "action": "agent",
        "agentId": "main",
        "sessionKey": "hook:draft:{{message}}",
        "deliver": false
      }
    ]
  },
  "skills": {
    "load": {
      "extraDirs": []
    },
    "entries": {}
  },
  "gateway": {
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "logging": {
    "level": "info"
  },
  "env": {
    "vars": {
      "PYR_API_URL": "http://host.docker.internal:3001",
      "PYR_API_KEY": "${API_KEY}"
    }
  }
}
