{
  "name": "@pyr/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/server.ts",
    "build": "tsc && copyfiles -u 1 'prisma/**/*' dist/",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate:test": "cross-env DATABASE_URL=postgresql://pyr:pyr_dev_password@localhost:5432/pyr_test prisma migrate deploy",
    "db:seed": "tsx ../../scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@bull-board/api": "^6",
    "@bull-board/fastify": "^6",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@prisma/client": "^6.2.1",
    "@pyr/shared": "workspace:*",
    "bullmq": "^5.34.8",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "franc-min": "^6.2.0",
    "ical-generator": "^10.0.0",
    "imapflow": "^1.0.171",
    "ioredis": "^5.4.2",
    "mailparser": "^3.9.3",
    "nodemailer": "^7.0.11",
    "openai": "^4.78.1",
    "pino": "^9.6.0",
    "sanitize-html": "^2.17.1",
    "tsdav": "^2.1.8",
    "ws": "^8.19.0",
    "zod": "^3.24.1",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
